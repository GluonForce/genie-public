# Database (Supabase Postgres, session pooler connection string)
DATABASE_URL=

# Supabase Storage
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# OpenRouter (same model ids as internal Genie)
OPENROUTER_API_KEY=
CODING_AGENT=
FALLBACK_CODING_AGENT=
CODING_AGENT_EFFORT=medium

# Sandbox provider (see genie_worker/sandbox); only "e2b" for now
SANDBOX_PROVIDER=e2b

# E2B
E2B_API_KEY=
E2B_TEMPLATE=genie-web

# Cloudflare R2 (S3 API) and KV
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KV_NAMESPACE_ID=

# Prototype host base domain; leave as localhost:8787 until the domain is bought
PROTO_BASE_DOMAIN=localhost:8787

# Email
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_ALERT_EMAILS=
