# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase: server only. The browser never talks to Supabase directly,
# so there are deliberately no NEXT_PUBLIC_SUPABASE_* keys.
# Database: transaction pooler connection string
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# OpenRouter (same model ids as internal Genie)
OPENROUTER_API_KEY=
TRANSCRIBING_AGENT=
REQUIREMENT_AGENT=

# Cloudflare KV (prototype state: preview, live, expired, offline)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KV_NAMESPACE_ID=

# Prototype host base domain; leave as localhost:8787 until the domain is bought
PROTO_BASE_DOMAIN=localhost:8787
PREVIEW_TOKEN_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_ALERT_EMAILS=
